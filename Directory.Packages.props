<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- Shared version variables to keep families aligned. -->
    <AspireVersion>13.4.6</AspireVersion>
    <OpenTelemetryVersion>1.10.0</OpenTelemetryVersion>
  </PropertyGroup>
  <ItemGroup Label="Data access (SQLite + Dapper)">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageVersion Include="Dapper" Version="2.1.79" />
  </ItemGroup>
  <ItemGroup Label="Resilience, hosting, service discovery, rate limiting (first-party)">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.7.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.7.0" />
    <PackageVersion Include="System.Threading.RateLimiting" Version="10.0.9" />
  </ItemGroup>
  <ItemGroup Label="ASP.NET Core add-ons (first-party)">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
  </ItemGroup>
  <ItemGroup Label=".NET Aspire orchestration">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="$(AspireVersion)" />
  </ItemGroup>
  <ItemGroup Label="OpenTelemetry">
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
  </ItemGroup>
  <ItemGroup Label="Testing (TUnit runner + Shouldly + bUnit + NSubstitute)">
    <PackageVersion Include="TUnit" Version="1.57.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="bunit.web" Version="1.40.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
  </ItemGroup>
  <!--
    SQLite native + SQLitePCLRaw transitive pins.

    Microsoft.Data.Sqlite 10.0.9 depends transitively on:
      SQLitePCLRaw.bundle_e_sqlite3 (>= 2.1.11)  -> resolves to 3.0.3
      SQLitePCLRaw.core            (>= 2.1.11)  -> resolves to 3.0.3
    and bundle_e_sqlite3 3.0.3 in turn depends on:
      SourceGear.sqlite3            (>= 3.50.4.5)  - the NATIVE SQLite build
      SQLitePCLRaw.config.e_sqlite3 (>= 3.0.3)

    The native-code package was RENAMED from `SQLitePCLRaw.lib.e_sqlite3`
    (last published 2.1.11) to `SourceGear.sqlite3` (3.50.x). The previous pin
    of `SQLitePCLRaw.lib.e_sqlite3` to 2.1.12 caused NU1603 because 2.1.12 does
    not exist on nuget.org (the resolver fell back to 3.50.3). It is also no
    longer part of the 3.x resolution graph at all, so it was removed.

    With CentralPackageTransitivePinningEnabled, these transitive packages must
    be pinned here to be deterministic. They are pinned to the versions the
    modern chain actually resolves to.
  -->
  <ItemGroup Label="SQLite native runtime (transitively pinned)">
    <PackageVersion Include="SourceGear.sqlite3" Version="3.50.4.5" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="3.0.3" />
    <PackageVersion Include="SQLitePCLRaw.config.e_sqlite3" Version="3.0.3" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="3.0.3" />
  </ItemGroup>
</Project>
